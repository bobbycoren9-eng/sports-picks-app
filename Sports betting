<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sports Picks App</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0b0c10;
      color: #f5f5f5;
      margin: 0;
      padding: 0;
    }
    header {
      background: #1f2833;
      padding: 20px;
      text-align: center;
    }
    header h1 {
      margin: 0;
      color: #66fcf1;
      font-size: 2em;
    }
    header p {
      margin: 8px 0 0;
      color: #c5c6c7;
    }
    .controls {
      text-align: center;
      margin: 15px;
    }
    button {
      background: #45a29e;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      font-size: 1em;
      cursor: pointer;
    }
    button:hover {
      background: #66fcf1;
      color: #0b0c10;
    }
    .picks {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      padding: 20px;
    }
    .card {
      background: #1f2833;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      transition: transform 0.2s;
    }
    .card:hover {
      transform: scale(1.03);
    }
    .card h2 {
      color: #45a29e;
      margin-bottom: 10px;
    }
    footer {
      background: #1f2833;
      padding: 10px;
      text-align: center;
      margin-top: 20px;
      font-size: 0.9em;
      color: #888;
    }
  </style>
</head>
<body>
  <header>
    <h1>🔥 Sports Picks (DraftKings) 🔥</h1>
    <p>Daily updated best value picks</p>
  </header>

  <div class="controls">
    <button onclick="loadPicks()">🔄 Update Picks</button>
  </div>

  <main>
    <div id="picks" class="picks">
      <p style="text-align:center;">Loading picks...</p>
    </div>
  </main>

  <footer>
    Sports Picks App © 2025 | Auto-refreshes every 6 hours
  </footer>

  <script>
    const API_KEY = "47b182823d44a13624d211d1b94e3069";
    const SPORTS = {
      NFL: "americanfootball_nfl",
      NBA: "basketball_nba",
      MLB: "baseball_mlb",
      NHL: "icehockey_nhl"
    };
    const BOOKMAKER = "draftkings";
    const REGION = "us";

    async function fetchOdds(sportKey) {
      const url = `https://api.the-odds-api.com/v4/sports/${sportKey}/odds/?regions=${REGION}&oddsFormat=american&markets=h2h&bookmakers=${BOOKMAKER}&apiKey=${API_KEY}`;
      try {
        const res = await fetch(url);
        if (!res.ok) return [];
        return await res.json();
      } catch (err) {
        console.error("Fetch error", err);
        return [];
      }
    }

    function pickBest(odds) {
      return odds.map(game => {
        if (!game.bookmakers?.length) return null;
        const bookmaker = game.bookmakers[0];
        const market = bookmaker.markets[0];
        const outcomes = market.outcomes;

        let best = outcomes.reduce((prev, curr) => {
          const implied = curr.price > 0
            ? 100 / (curr.price + 100)
            : -curr.price / (-curr.price + 100);
          return implied < prev.implied ? { ...curr, implied } : prev;
        }, { implied: 1 });

        return {
          sport: game.sport_title,
          match: `${game.home_team} vs ${game.away_team}`,
          team: best.name,
          odds: best.price
        };
      }).filter(Boolean);
    }

    async function loadPicks() {
      const container = document.getElementById("picks");
      container.innerHTML = "<p style='text-align:center;'>Loading picks...</p>";
      let allPicks = [];

      for (const [name, key] of Object.entries(SPORTS)) {
        const odds = await fetchOdds(key);
        const picks = pickBest(odds);
        allPicks = allPicks.concat(picks);
      }

      container.innerHTML = "";
      if (allPicks.length === 0) {
        container.innerHTML = "<p style='text-align:center;'>No picks available right now.</p>";
        return;
      }

      allPicks.forEach(pick => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `
          <h2>${pick.sport}</h2>
          <p><strong>Match:</strong> ${pick.match}</p>
          <p><strong>Pick:</strong> ${pick.team}</p>
          <p><strong>Odds:</strong> ${pick.odds}</p>
        `;
        container.appendChild(card);
      });
    }

    // Run immediately
    loadPicks();
    // Auto refresh every 6 hours
    setInterval(loadPicks, 6 * 60 * 60 * 1000);
  </script>
</body>
</html>
